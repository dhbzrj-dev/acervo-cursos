# Token do bot, obtido no @BotFather.
BOT_TOKEN=123456:ABC-DEF...

# URL pública do Mini App (a mesma configurada no @BotFather via /newapp
# ou /setmenubutton), aberta pelo comando /start.
MINI_APP_URL=https://acervo-cursos.vercel.app

# URL do backend (Fastify), para as rotas /internal/*.
BACKEND_URL=https://api.seudominio.com

# Mesma chave configurada em backend/.env — autentica as chamadas do bot
# nas rotas /internal/*.
INTERNAL_API_KEY=troque-por-um-valor-aleatorio-forte
