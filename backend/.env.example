# Porta em que o Fastify escuta
PORT=3000

# String de conexão do Postgres (Supabase, Railway, RDS, etc.)
DATABASE_URL=postgres://user:password@localhost:5432/acervo_cursos

# Mesmo token do bot usado em /bot — necessário para validar o HMAC do
# Telegram.WebApp.initData enviado pelo Mini App em cada requisição autenticada.
BOT_TOKEN=123456:ABC-DEF...

# Origem(ns) do frontend liberadas no CORS, separadas por vírgula.
FRONTEND_ORIGINS=https://acervo-cursos.vercel.app,http://localhost:5173

# Quantos segundos o initData é considerado válido após ser gerado pelo
# Telegram (proteção contra replay). 86400 = 24h é um valor seguro e comum.
INIT_DATA_MAX_AGE_SECONDS=86400

# Chave compartilhada apenas entre o backend e o processo do bot, usada nas
# rotas /internal/* (o bot avisa aqui quando alguém entra/sai de um canal).
# Gere algo aleatório e forte, ex: `openssl rand -hex 32`.
INTERNAL_API_KEY=troque-por-um-valor-aleatorio-forte
